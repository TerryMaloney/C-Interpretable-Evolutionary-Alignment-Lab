# Anomaly Correlation Map — Environment Variables
# Copy to .env and fill in values as needed

# Optional: NASA SEDAC credentials (free registration) for population grid download
NASA_SEDAC_USERNAME=
NASA_SEDAC_PASSWORD=

# Optional: EPA CDX credentials (free registration) for RadNet data export
EPA_CDX_USERNAME=
EPA_CDX_PASSWORD=

# Optional: Geocoding API key (for geocode_manual.py address fallback)
# Free tier: Nominatim (OpenStreetMap) — no key needed, rate-limited
# Paid tier: Google Geocoding, Mapbox
GEOCODING_API_KEY=
GEOCODING_PROVIDER=nominatim

# Data directory overrides (defaults to project-relative paths)
# RAW_DATA_DIR=./data/raw
# PROCESSED_DATA_DIR=./data/processed
# OUTPUT_DIR=./output

# USGS earthquake API parameters
USGS_MIN_MAGNITUDE=2.5
USGS_START_DATE=2000-01-01
# Omit USGS_END_DATE to fetch through today

# Rate limiting (seconds between requests)
REQUEST_DELAY=1.0
